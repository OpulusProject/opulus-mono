{
  "name": "@opulus/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "prisma:generate": "pnpm --filter @opulus/core prisma:generate",
    "prisma:studio": "pnpm --filter @opulus/core prisma:studio",
    "prisma:migrate": "pnpm --filter @opulus/core prisma:migrate",
    "prisma:migrate:deploy": "pnpm --filter @opulus/core prisma:migrate:deploy",
    "prisma:migrate:reset": "pnpm --filter @opulus/core prisma:migrate:reset",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@opulus/core": "workspace:*",
    "better-auth": "^1.3.34",
    "config": "^3.3.12",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.3.34",
    "@types/config": "^3.3.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/node": "^22.2.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "prisma": "^6.3.1",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
