# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/opulus?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Set to "true" when connecting to a managed Redis that requires TLS
# REDIS_TLS=false

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-local-secret"
BETTER_AUTH_BASE_URL="http://localhost:8080"

# Encrypts Plaid access tokens at rest. Required: the backend and webhooks
# services refuse to start without it. 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Keep it out of the database and out of git. Losing it makes stored tokens
# unreadable (users would have to relink their banks), and changing it breaks
# every token encrypted with the old value. Use a different key per environment.
ITEM_TOKEN_ENCRYPTION_KEY=""

# Plaid
# Use sandbox credentials for local development.
PLAID_CLIENT_ID="replace-me"
PLAID_SECRET="replace-me"
PLAID_ENV="sandbox"
PLAID_VERSION="2020-09-14"
# Full webhook URL (including path) that Plaid will POST to.
# For local dev, use a tunnel like zrok/ngrok, e.g. https://xxx.share.zrok.io/webhook/plaid
PLAID_WEBHOOK_URL=""

# Exchange rates, refreshed daily into the exchange_rate table by opulus-scheduler.
# Defaults to Frankfurter's public API (the European Central Bank's daily rates,
# no key needed). Point it at another Frankfurter deployment, or a stub in tests.
# FRANKFURTER_BASE_URL="https://api.frankfurter.dev/v1"

# Scheduler (opulus-scheduler). The jobs API (run a job now) is only on when
# SCHEDULER_ADMIN_TOKEN is set; generate one with: openssl rand -base64 32
SCHEDULER_PORT=8082
# SCHEDULER_ADMIN_TOKEN=""
# SCHEDULER_RUN_ON_START=true
# EXCHANGE_RATES_CRON="0 17 * * *"

# Application
CLIENT_URL="http://localhost:5173"
PORT=8080
WEBHOOK_PORT=8081

# Reject passwords found in known breaches (Have I Been Pwned) at sign-up and on
# a password change. On by default; "off" skips the check (and its network call).
# BREACHED_PASSWORD_CHECK=off

# Two-factor is required of every user: until they confirm an authenticator app
# the API answers 403 TWO_FACTOR_REQUIRED to everything but their session. Set to
# "false" only to run a frontend that has no set-up screen yet.
# REQUIRE_TWO_FACTOR=true

# Rate limiting (requests per minute)
# One IP address across the API, and one signed-in user on the routes that call Plaid.
# RATE_LIMIT_PER_IP=600
# RATE_LIMIT_PLAID_PER_USER=10
# Where the counters live: "redis" (shared by every backend instance, uses REDIS_HOST)
# or unset for in-memory (each instance counts for itself).
# RATE_LIMIT_STORE=redis
# Webhook receiver: requests per minute from one IP address (counted before the
# signature is checked).
# WEBHOOK_RATE_LIMIT_PER_IP=120

# Plaid OAuth: the page on the frontend Plaid sends the user back to after they log
# in at an OAuth bank. Register the same URL under Allowed redirect URIs in the
# Plaid dashboard (HTTPS in production). Unset, no redirect is offered and OAuth
# banks cannot complete Link.
# PLAID_REDIRECT_URI=http://localhost:5173/settings/connections
