# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/opulus?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-local-secret"
BETTER_AUTH_BASE_URL="http://localhost:8080"

# Plaid
# Use sandbox credentials for local development.
PLAID_CLIENT_ID="replace-me"
PLAID_SECRET="replace-me"
PLAID_ENV="sandbox"
PLAID_VERSION="2020-09-14"
PLAID_WEBHOOK_URL=""

# Application
CLIENT_URL="http://localhost:5173"
PORT=8080
WEBHOOK_PORT=8081

