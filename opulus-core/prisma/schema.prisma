generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id
  name                   String
  email                  String
  emailVerified          Boolean                 @default(false)
  image                  String?
  plaidId                String?                 @unique
  plaidUserToken         String?                 @unique
  twoFactorEnabled       Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now()) @updatedAt
  sessions               Session[]
  authAccounts           AuthAccount[]
  linkSessions           LinkSession[]
  linkEvents             LinkEvent[]
  accountLiabilities     AccountLiability[]
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]
  recurringStreams       RecurringStream[]
  items                  Item[]
  accounts               Account[]
  transactions           Transaction[]
  twoFactor              TwoFactor?
  passkeys               Passkey[]

  @@unique([email])
  @@map("user")
}

model Session {
  id         String      @id
  expiresAt  DateTime
  token      String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  ipAddress  String?
  userAgent  String?
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkEvents LinkEvent[]

  @@unique([token])
  @@map("session")
}

/// better-auth's linked-login table (credentials and OAuth providers). Named
/// AuthAccount so "Account" can mean a financial account.
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model LinkSession {
  id        String   @id @default(cuid())
  userId    String
  linkToken String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("link_session")
}

/// An event from Plaid's Link flow, reported by the browser (Link runs there).
/// Kept so a failed connection can be traced: `sessionId` ties it to the login
/// session it happened in, and `plaidLinkSessionId` and `plaidRequestId` are
/// what Plaid support asks for.
model LinkEvent {
  id                 String   @id @default(cuid())
  userId             String
  /// The login session the event was reported in; null once that session is deleted.
  sessionId          String?
  eventName          String
  mode               String // new, reconnect or add-accounts
  itemId             String? // our item id, for update mode
  plaidLinkSessionId String? // groups the events of one Link flow
  plaidRequestId     String?
  institutionId      String?
  institutionName    String?
  viewName           String?
  exitStatus         String?
  errorType          String?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session            Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([plaidLinkSessionId])
  @@map("link_event")
}

model Item {
  id                             String                  @id @default(cuid())
  plaidItemId                    String                  @unique
  userId                         String
  accessToken                    String
  institutionId                  String?
  institutionName                String?
  institutionColor               String? // Primary brand color from Plaid
  institutionLogo                String? // Logo URL from Plaid
  webhook                        String?
  errorType                      String?
  errorCode                      String?
  errorMessage                   String?
  displayMessage                 String?
  newAccountsAvailable           Boolean                 @default(false) // Plaid detected accounts the user has not shared yet
  availableProducts              String[]                @default([])
  billedProducts                 String[]                @default([])
  products                       String[]                @default([])
  updateType                     String // "background" | "user_present_required"
  consentExpirationTime          DateTime?
  transactionCursor              String? // Cursor for /transactions/sync pagination
  syncedAt                       DateTime? // Set only after a successful transactions_sync
  investmentTransactionsSyncedAt DateTime? // Set only after a successful investment transactions sync
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt
  user                           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts                       Account[]
  transactions                   Transaction[]
  accountLiabilities             AccountLiability[]
  holdings                       Holding[]
  investmentTransactions         InvestmentTransaction[]
  recurringStreams               RecurringStream[]

  @@map("item")
}

model Account {
  id                     String                  @id @default(cuid())
  providerAccountId      String // Provider's account_id (may change across item updates)
  persistentAccountId    String? // Stable account identifier across item updates
  itemId                 String // Reference to Item (connection to financial institution)
  userId                 String // Reference to User
  name                   String
  officialName           String?
  type                   String // e.g., "depository", "credit", "loan", "investment", etc.
  subtype                String? // e.g., "checking", "savings", "credit card", etc.
  mask                   String? // Last 2-4 alphanumeric characters of account number
  balanceAvailable       Decimal? // Available balance
  balanceCurrent         Decimal? // Current balance
  balanceLimit           Decimal? // Credit limit (for credit accounts)
  isoCurrencyCode        String? // ISO 4217 currency code (e.g., "USD", "CAD")
  unofficialCurrencyCode String? // Unofficial currency code (used when ISO currency unavailable)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  item                   Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transactions           Transaction[]
  liabilityDetails       AccountLiability?
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]
  recurringStreams       RecurringStream[]

  // Same account_id can exist in different items
  // Index for stable account lookups
  @@unique([providerAccountId, itemId])
  @@index([persistentAccountId])
  @@map("account")
}

model Transaction {
  id                     String    @id @default(cuid())
  providerTransactionId  String // Plaid transaction_id (unique per transaction)
  accountId              String // Reference to Account
  itemId                 String // Reference to Item
  userId                 String // Reference to User
  amount                 Decimal   @db.Decimal(19, 4) // Positive = money out, negative = money in (Plaid's convention)
  date                   DateTime // Date transaction occurred (YYYY-MM-DD)
  authorizedDate         DateTime? // Date transaction was authorized (YYYY-MM-DD)
  name                   String // Merchant name or transaction description
  merchantName           String? // Merchant name if available
  categoryPrimary        String? // Plaid personal finance category, high level (e.g. FOOD_AND_DRINK)
  categoryDetailed       String? // Plaid personal finance category, granular (e.g. FOOD_AND_DRINK_FAST_FOOD)
  paymentChannel         String? // online, in store or other
  logoUrl                String? // Merchant logo (100x100 PNG), when Plaid has one
  website                String? // Merchant website, when Plaid has one
  location               Json? // Plaid's location object; only for physical locations
  paymentMeta            Json? // Plaid's payment_meta object; only for inter-bank transfers
  isoCurrencyCode        String? // ISO 4217 currency code
  unofficialCurrencyCode String? // Unofficial currency code
  pending                Boolean   @default(false) // Whether transaction is pending
  pendingTransactionId   String? // ID of pending transaction if this is a posted transaction
  accountOwner           String? // Account owner name
  transactionCode        String? // Transaction code (e.g., "direct_debit")
  merchantEntityId       String? // Merchant entity ID
  checkNumber            String? // Check number if applicable
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item                   Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  account                Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Same transaction_id can exist in different accounts
  @@unique([providerTransactionId, accountId])
  @@index([accountId])
  @@index([itemId])
  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@map("transaction")
}

/// Liabilities data (Plaid /liabilities/get) for a credit or loan account.
/// One row per account; refreshed on link and on LIABILITIES webhooks.
/// Deliberately excludes account numbers, property and servicer addresses, and
/// payment reference numbers.
model AccountLiability {
  id                     String    @id @default(cuid())
  accountId              String    @unique // Account this describes
  itemId                 String
  userId                 String
  kind                   String // "credit" | "mortgage" | "student"
  isOverdue              Boolean?
  nextPaymentDueDate     DateTime?
  minimumPayment         Decimal? // Credit/student minimum payment; mortgage next monthly payment
  lastPaymentAmount      Decimal?
  lastPaymentDate        DateTime?
  lastStatementBalance   Decimal?
  lastStatementIssueDate DateTime?
  interestRate           Decimal? // Percentage (mortgage, student loan)
  originationDate        DateTime?
  originationPrincipal   Decimal?
  maturityDate           DateTime? // Mortgage maturity date or student loan expected payoff date
  aprs                   Json? // Credit card APRs: [{ type, percentage, balanceSubjectToApr, interestChargeAmount }]
  details                Json? // Kind-specific extras that do not need their own column yet
  syncedAt               DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item                   Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  account                Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([userId])
  @@map("account_liability")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  secret                  String? // Encrypted secret for TOTP
  backupCodes             String? // Encrypted backup codes (JSON array)
  /// false until the user confirms enrollment with a code
  verified                Boolean   @default(true)
  /// wrong codes in a row; locks the second factor for a while at the limit
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

/// Daily reference exchange rates, as units of a currency for one euro (the
/// European Central Bank publishes against the euro; any other base is a cross
/// rate of two rows on the same day). One row per currency per published day;
/// weekends and holidays have none. The euro itself is stored as 1, so a
/// lookup never needs a special case. Not per user: shared by everyone.
/// Refreshed daily by opulus-scheduler, with about two years of history.
model ExchangeRate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date // The day the rate was published (UTC)
  currency  String // ISO 4217 code, e.g. "USD"
  perEur    Decimal  @db.Decimal(20, 10) // Units of `currency` for one euro
  source    String // Where the rate came from, e.g. "frankfurter"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One rate per currency per day
  @@unique([date, currency])
  // A currency's rates over a date range (converting amounts)
  @@index([currency, date])
  @@map("exchange_rate")
}

/// better-auth's rate limit counters, one row per client address and route.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

/// A WebAuthn credential a user signed up with (better-auth passkey plugin).
model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

/// A security (a stock, ETF, fund, bond, cash) Plaid describes. Shared by every
/// user: it is public information about the instrument, not about anyone's
/// holding of it.
model Security {
  id                     String                  @id @default(cuid())
  plaidSecurityId        String                  @unique
  name                   String?
  tickerSymbol           String?
  type                   String? // equity, etf, mutual fund, fixed income, cash, ...
  isCashEquivalent       Boolean                 @default(false)
  isoCurrencyCode        String?
  unofficialCurrencyCode String? // a currency ISO 4217 has no code for, such as a cryptocurrency's
  marketIdentifierCode   String? // the ISO 10383 code of the exchange it trades on, when Plaid has one
  // An option contract (type "derivative"):
  optionContractType     String? // "call" or "put"
  optionExpirationDate   DateTime?
  optionStrikePrice      Decimal?
  optionUnderlyingTicker String?
  // A bond or other fixed income security (type "fixed income"):
  bondMaturityDate       DateTime?
  bondIssueDate          DateTime?
  bondFaceValue          Decimal?
  bondYieldRate          Decimal? // a percentage; bondYieldType says which kind
  bondYieldType          String? // coupon, coupon_equivalent, discount, yield_to_maturity or yield_to_worst
  // When its price history was last fetched from the market-data provider (see
  // ACTIVE_PRICE_PROVIDER); null until it has been. Every security is priced, so
  // there is nothing more to track. Changing provider means clearing this on
  // every security and fetching the history again.
  priceBackfilledAt      DateTime?
  // What the market-data provider says it pays out per share (see the
  // refresh-security-dividends job). The annual rate is in dividendCurrency: 0
  // for a security that pays nothing, null while the provider has not said
  // (cash, options and bonds never get one). The yield is a fraction (0.025 is 2.5%).
  dividendRate           Decimal?                @db.Decimal(20, 6)
  dividendYield          Decimal?                @db.Decimal(10, 6)
  dividendCurrency       String?
  dividendsFetchedAt     DateTime? // when the rate was last fetched; null until it has been
  updatedAt              DateTime                @updatedAt
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]
  prices                 SecurityPrice[]

  @@map("security")
}

/// A security's price on a day: the close for a past day, and for today the
/// latest quote (replaced every few minutes, and the close once the day ends).
/// About two years of days are kept. Not per user: shared by everyone.
model SecurityPrice {
  id         String   @id @default(cuid())
  securityId String
  date       DateTime @db.Date // The trading day (UTC date of the quote)
  close      Decimal  @db.Decimal(20, 6) // In `currency`
  currency   String // ISO 4217 code the price is in
  source     String // the provider, e.g. "yahoo"
  asOf       DateTime // when the provider says the price is from
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  security   Security @relation(fields: [securityId], references: [id], onDelete: Restrict)

  // One price per security per day
  @@unique([securityId, date])
  // The days of a date range, across securities
  @@index([date])
  @@map("security_price")
}

/// How much of a security an investment account holds right now, as of Plaid's
/// last pull from the institution. A snapshot: it is replaced on each sync, not
/// kept as history.
model Holding {
  id               String   @id @default(cuid())
  accountId        String
  securityId       String
  itemId           String
  userId           String
  quantity         Decimal
  institutionValue Decimal // the whole holding's value, as the institution reports it
  costBasis        Decimal? // the total paid for everything held; many institutions send none
  isoCurrencyCode  String?
  syncedAt         DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  security         Security @relation(fields: [securityId], references: [id])
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, securityId])
  @@index([itemId])
  @@index([userId])
  @@map("holding")
}

/// A buy, sell, dividend, deposit, fee or other event Plaid reports in an
/// investment account. Replaced by window on each sync (Plaid can change or cancel
/// a recent one), so what is stored is Plaid's current view of the period synced.
model InvestmentTransaction {
  id                           String    @id @default(cuid())
  plaidInvestmentTransactionId String    @unique
  accountId                    String
  itemId                       String
  userId                       String
  securityId                   String? // none for cash movements and fees
  date                         DateTime
  name                         String
  /// buy, sell, cancel, cash, fee or transfer (Plaid's type)
  type                         String
  /// Plaid's subtype: dividend, contribution, deposit, withdrawal, interest, ...
  subtype                      String?
  quantity                     Decimal?
  price                        Decimal?
  amount                       Decimal // Plaid's sign: money out of the account is positive, so a buy is positive and a dividend negative
  fees                         Decimal?
  isoCurrencyCode              String?
  unofficialCurrencyCode       String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  account                      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  item                         Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  security                     Security? @relation(fields: [securityId], references: [id])

  @@index([userId, date])
  @@index([accountId, date])
  @@index([itemId])
  @@map("investment_transaction")
}

/// A recurring payment or income Plaid found in an account's transactions (a
/// subscription, a bill, a salary): "stream" is Plaid's word. Replaced on each
/// sync, so what is stored is Plaid's current view.
model RecurringStream {
  id                String    @id @default(cuid())
  plaidStreamId     String
  accountId         String
  itemId            String
  userId            String
  direction         String // "inflow" (money in) or "outflow" (money out)
  description       String
  merchantName      String?
  /// WEEKLY, BIWEEKLY, SEMI_MONTHLY, MONTHLY, ANNUALLY or UNKNOWN
  frequency         String
  /// MATURE, EARLY_DETECTION, TOMBSTONED (it stopped) or UNKNOWN
  status            String
  isActive          Boolean
  firstDate         DateTime
  lastDate          DateTime
  predictedNextDate DateTime?
  averageAmount     Decimal // always positive: `direction` says which way the money goes
  lastAmount        Decimal
  isoCurrencyCode   String?
  category          String? // Plaid's personal finance category, primary
  syncedAt          DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  item              Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, plaidStreamId])
  @@index([userId])
  @@map("recurring_stream")
}

/// A webhook event a worker handled or gave up on: the audit trail of what
/// Plaid told us and what we did with it. One row per queue job, written as the
/// job runs. A dead event that is replayed gets a row of its own when the new
/// job runs.
model WebhookEvent {
  id          String             @id @default(cuid())
  source      String             @default("plaid")
  jobId       String // the queue job's id; unique only with receivedAt, because a flushed Redis starts its ids over
  webhookType String // ITEM, TRANSACTIONS, ...
  webhookCode String // SYNC_UPDATES_AVAILABLE, ...
  plaidItemId String? // Plaid's item id, when the event has one
  payload     Json // the whole event as received, to read it later and to replay it
  status      WebhookEventStatus
  attempts    Int                @default(0)
  error       String? // why the last attempt failed
  receivedAt  DateTime // when the event was queued
  processedAt DateTime? // when it was handled, or given up on
  replayedAt  DateTime? // when a dead event was put back on the queue

  @@unique([jobId, receivedAt])
  @@index([plaidItemId, receivedAt])
  @@index([status, receivedAt])
  @@index([receivedAt])
  @@map("webhook_event")
}

enum WebhookEventStatus {
  processing // a worker has the job
  processed // the handler finished
  retrying // an attempt failed and the job will run again
  dead // retries used up, or it failed in a way that is never retried
}
