{
  "name": "@opulus/mono",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "pnpm --filter @opulus/frontend dev",
    "dev:backend": "concurrently \"pnpm --filter @opulus/core dev\" \"pnpm --filter @opulus/backend dev\" --names \"core,backend\" --prefix-colors \"blue,green\"",
    "dev:webhooks": "concurrently \"pnpm --filter @opulus/core dev\" \"pnpm --filter @opulus/webhooks dev\" --names \"core,webhooks\" --prefix-colors \"blue,yellow\"",
    "dev:webhooks:tunnel": "pnpm --filter @opulus/webhooks tunnel",
    "build": "pnpm --filter @opulus/core build && pnpm -r build",
    "build:core": "pnpm --filter @opulus/core build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "fix-all": "node scripts/fix-all.mjs",
    "type-check": "pnpm -r type-check",
    "clean": "rm -rf node_modules && pnpm -r exec rm -rf node_modules dist",
    "install:all": "pnpm install",
    "prisma:generate": "pnpm --filter @opulus/core prisma:generate",
    "prisma:migrate": "dotenv -e .env -- pnpm --filter @opulus/core prisma:migrate",
    "prisma:migrate:deploy": "dotenv -e .env -- pnpm --filter @opulus/core exec prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:studio": "dotenv -e .env -- pnpm --filter @opulus/core prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv-cli": "^11.0.0",
    "glob": "^13.0.0",
    "organize-imports-cli": "^0.10.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "@babel/core@7": "^7.29.6",
      "@humanfs/node@0.16": ">=0.16.8 <0.17.0",
      "@simplewebauthn/server@13": "^13.3.2",
      "ajv@6": "^6.14.0",
      "axios@1": "^1.20.0",
      "baseline-browser-mapping@2": "^2.11.0",
      "body-parser@2": "^2.3.0",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@1": "^1.1.21",
      "browserslist@4": "^4.28.7",
      "defu@6": "^6.1.5",
      "diff@8": "^8.0.3",
      "effect@3": "^3.20.0",
      "fast-copy@4": "^4.1.0",
      "flatted@3": "^3.4.2",
      "follow-redirects@1": "^1.16.0",
      "form-data@4": "^4.0.6",
      "js-yaml@4": "^4.3.2",
      "kysely@0.28": ">=0.28.17 <0.29.0",
      "lodash@4": "^4.18.0",
      "minimatch@3": "^3.1.4",
      "minimatch@10": "^10.2.3",
      "minimatch@9": "^9.0.7",
      "minimatch@5": "^5.1.8",
      "path-to-regexp@8": "^8.4.0",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "proxy-addr@2": "^2.0.8",
      "qs@6": "^6.16.0",
      "rollup@4": "^4.59.0",
      "seroval@1": "^1.6.3",
      "shell-quote@1": "^1.9.0",
      "source-map-js@1": "^1.2.2",
      "uuid@11": "^11.1.1",
      "webpack@5": "^5.104.1"
    }
  }
}
