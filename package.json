{
  "name": "@opulus/mono",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @opulus/gems dev\" \"pnpm --filter @opulus/frontend dev\" --names \"gems,frontend\" --prefix-colors \"cyan,magenta\"",
    "dev:backend": "concurrently \"pnpm --filter @opulus/core dev\" \"pnpm --filter @opulus/backend dev\" --names \"core,backend\" --prefix-colors \"blue,green\"",
    "dev:webhooks": "concurrently \"pnpm --filter @opulus/core dev\" \"pnpm --filter @opulus/webhooks dev\" --names \"core,webhooks\" --prefix-colors \"blue,yellow\"",
    "dev:frontend": "pnpm --filter @opulus/frontend dev",
    "dev:gems": "pnpm --filter @opulus/gems dev",
    "build": "pnpm --filter @opulus/core build && pnpm -r build",
    "build:core": "pnpm --filter @opulus/core build",
    "build:gems": "pnpm --filter @opulus/gems build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "fix-all": "node scripts/fix-all.mjs",
    "type-check": "pnpm -r type-check",
    "clean": "rm -rf node_modules && pnpm -r exec rm -rf node_modules dist",
    "install:all": "pnpm install",
    "prisma:generate": "pnpm --filter @opulus/core prisma:generate",
    "prisma:migrate": "dotenv -e .env -- pnpm --filter @opulus/core prisma:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv-cli": "^11.0.0",
    "glob": "^13.0.0",
    "organize-imports-cli": "^0.10.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
