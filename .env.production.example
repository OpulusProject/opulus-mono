# Settings for docker-compose.prod.yml. Copy to .env.production (never commit it)
# and pass it with: docker compose -f docker-compose.prod.yml --env-file .env.production ...

# The one URL every device uses to reach Opulus, https and with no trailing slash,
# e.g. https://homeserver.your-tailnet.ts.net. It is the API origin, the auth base
# URL and the only allowed CORS origin, and it is baked into the frontend bundle
# (rebuild the frontend image after changing it).
PUBLIC_URL=""

# Host port and address of the reverse proxy, the only published port. Pick a
# port no other service on the host uses. 127.0.0.1 keeps it reachable only via
# a TLS terminator on the same host (e.g. tailscale serve).
OPULUS_HTTP_PORT=8480
OPULUS_BIND_ADDRESS=127.0.0.1

# Internal only (never published). Use URL-safe values: openssl rand -hex 24
POSTGRES_PASSWORD=""
REDIS_PASSWORD=""

# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# openssl rand -base64 32. Back it up: losing it means relinking every bank.
ITEM_TOKEN_ENCRYPTION_KEY=""

# Plaid. Start with sandbox keys.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_VERSION="2020-09-14"
# Must be publicly reachable for transactions to sync. With the zrok profile it is
# https://<ZROK_UNIQUE_NAME>.share.zrok.io/webhook/plaid
PLAID_WEBHOOK_URL=""
# PLAID_REDIRECT_URI=https://homeserver.your-tailnet.ts.net/settings/connections

# zrok tunnel for Plaid webhooks (compose profile "zrok"). The enable token is
# on your account page at https://api-v1.zrok.io; the name is 4-32 lowercase
# letters and digits and becomes https://<name>.share.zrok.io.
ZROK_ENABLE_TOKEN=""
ZROK_UNIQUE_NAME=""

# Optional (see .env.example for what each does)
# SCHEDULER_ADMIN_TOKEN=""
# BREACHED_PASSWORD_CHECK=off
# RATE_LIMIT_PER_IP=600
