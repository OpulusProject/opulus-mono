{
  "name": "@opulus/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Black-box REST regression suites for the Opulus HTTP services.",
  "scripts": {
    "test:unit-core": "playwright test --config unit/playwright.config.ts",
    "test:services-backend": "playwright test --config services/backend/playwright.config.ts",
    "test:services-webhooks": "playwright test --config services/webhooks/playwright.config.ts",
    "test:integration-backend": "playwright test --config integration/backend/playwright.config.ts",
    "test:integration-webhooks": "playwright test --config integration/webhooks/playwright.config.ts",
    "test:services-scheduler": "playwright test --config services/scheduler/playwright.config.ts",
    "test:deployment-backend": "playwright test --config deployment/backend/playwright.config.ts",
    "test:deployment-images": "playwright test --config deployment/images/playwright.config.ts",
    "test:deployment-webhooks": "playwright test --config deployment/webhooks/playwright.config.ts",
    "test:deployment-scheduler": "playwright test --config deployment/scheduler/playwright.config.ts",
    "test:deployment-config": "playwright test --config deployment/config/playwright.config.ts",
    "test:integration-scheduler": "playwright test --config integration/scheduler/playwright.config.ts",
    "test:deployment-migrations": "playwright test --config deployment/migrations/playwright.config.ts",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@opulus/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "bullmq": "^5.0.0",
    "cbor-x": "^1.6.6",
    "otpauth": "^9.5.2",
    "zod": "^4.3.5"
  }
}
