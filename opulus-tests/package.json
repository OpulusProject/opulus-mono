{
  "name": "@opulus/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Black-box REST regression suites for the Opulus HTTP services.",
  "scripts": {
    "test:unit-core": "playwright test --config unit/playwright.config.ts",
    "test:services-backend": "playwright test --config services/backend/playwright.config.ts",
    "test:services-webhooks": "playwright test --config services/webhooks/playwright.config.ts",
    "test:integration-backend": "playwright test --config integration/backend/playwright.config.ts",
    "test:integration-webhooks": "playwright test --config integration/webhooks/playwright.config.ts",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@opulus/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "otpauth": "^9.5.2",
    "zod": "^3.23.8"
  }
}
